{
  "name": "@sourcebook/plugin-flue",
  "version": "0.0.1",
  "type": "module",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@flue/runtime": "catalog:",
    "@sourcebook/core": "workspace:*",
    "tslib": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@powerlines/plugin-tsdown": "catalog:",
    "powerlines": "catalog:"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./package.json": "./package.json"
  }
}
