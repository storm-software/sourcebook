{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "rootDir": "src",
    "paths": {
      "@sourcebook/config": ["../config/src/index.ts"]
    },
    "types": ["node"],
    "declarationMap": false,
    "importHelpers": false,
    "outDir": "dist"
  },
  "references": [{ "path": "../config" }],
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
